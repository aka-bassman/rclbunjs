{
  "name": "rclbunjs",
  "version": "0.9.0",
  "description": "Bun-native ROS 2 client library (bun:ffi over rcl)",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-bassman/rclbunjs.git"
  },
  "homepage": "https://github.com/aka-bassman/rclbunjs#readme",
  "bugs": {
    "url": "https://github.com/aka-bassman/rclbunjs/issues"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test/unit",
    "test:docker": "scripts/docker-test.sh",
    "build:native": "scripts/build-native.sh",
    "test:types": "tsc --noEmit -p test/types",
    "test:integration": "scripts/docker-test.sh bun test test/integration",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:npm": "bun run typecheck && bun run test:types && bun run test:unit && changeset publish",
    "build:types": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build:types"
  },
  "dependencies": {
    "@foxglove/message-definition": "0.5.0",
    "@foxglove/ros2idl-parser": "0.3.6",
    "@foxglove/rosmsg": "5.0.5"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "rxjs": "7.8.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "rclbunjs-typegen": "bin/rclbunjs-typegen.ts",
    "rclbunjs-build-shim": "bin/rclbunjs-build-shim.ts"
  }
}
